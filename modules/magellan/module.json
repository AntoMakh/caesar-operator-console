{
    "name": "magellan",
    "description": "Magellan multi-threaded DNS subdomain enumerator",
    "entry": "magellan.py",
    "options": {
        "DOMAIN": {
            "required": true,
            "description": "Target root domain (e.g. example.com)"
        },
        "WORDLIST": {
            "required": true,
            "type": "file",
            "must_exist": true,
            "description": "Path to subdomain wordlist"
        },
        "THREADS": {
            "required": false,
            "default": "10",
            "type": "integer",
            "min": 1,
            "max": 100,
            "flag": "--threads",
            "description": "Number of concurrent worker threads"
        }
    },
    "argument_order": [
        "DOMAIN",
        "WORDLIST",
        "THREADS"
    ],
    "dependencies": []
}
